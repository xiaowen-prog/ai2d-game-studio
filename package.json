{
  "name": "zaojing-game-studio",
  "version": "0.1.0-preview.3.2",
  "private": true,
  "type": "module",
  "description": "Local-first desktop agent that turns a prompt into a reviewed, playable Web or Godot game with Codex App Server",
  "author": "xiaowen-prog",
  "homepage": "https://github.com/xiaowen-prog/ai2d-game-studio#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xiaowen-prog/ai2d-game-studio.git"
  },
  "bugs": {
    "url": "https://github.com/xiaowen-prog/ai2d-game-studio/issues"
  },
  "keywords": [
    "codex",
    "codex-app-server",
    "ai-agent",
    "game-development",
    "game-generator",
    "godot",
    "threejs",
    "electron",
    "mcp"
  ],
  "engines": {
    "node": ">=22",
    "npm": ">=10"
  },
  "main": "dist/main/main.js",
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "dev": "concurrently -k \"vite --host 127.0.0.1 --port 5174\" \"tsc -p tsconfig.main.json --watch --preserveWatchOutput\" \"wait-on tcp:5174 file:dist/main/main.js file:dist/main/preload.cjs && cross-env NOOBI_RENDERER_URL=http://127.0.0.1:5174 electron .\"",
    "online:bridge": "npm run build && cross-env NOOBI_BROWSER_STUDIO=1 NOOBI_BROWSER_OPEN=0 electron .",
    "typecheck": "tsc --noEmit -p tsconfig.renderer.json && tsc --noEmit -p tsconfig.main.json",
    "build:renderer": "vite build",
    "build:main": "tsc -p tsconfig.main.json",
    "build": "npm run clean && npm run typecheck && npm run build:renderer && npm run build:main",
    "test": "vitest run",
    "test:watch": "vitest",
    "protocol:generate": "tsx scripts/generate-codex-protocol.ts",
    "smoke:codex": "tsx scripts/codex-smoke.ts",
    "smoke:harness": "tsx scripts/harness-smoke.ts",
    "smoke:media": "tsx scripts/media-smoke.ts",
    "smoke:image": "tsx scripts/image-smoke.ts",
    "smoke:icon": "tsx scripts/icon-smoke.ts",
    "smoke:playtest": "npm run build && electron scripts/playtest-smoke-app",
    "smoke:model3d": "tsx scripts/model3d-smoke.ts",
    "assets:transition-gifs": "node scripts/build-noobi-transition-gifs.mjs",
    "smoke:godot": "tsx scripts/godot-smoke.ts",
    "smoke:ui": "npm run build && cross-env NOOBI_SMOKE_CAPTURE=.noobi-smoke/workbench.png electron .",
    "verify": "npm run typecheck && npm run test && npm run build",
    "package:mac": "node scripts/packaging/prepare.mjs && npm run build && cross-env ELECTRON_BUILDER_CACHE=.noobi-private/electron-builder-cache electron-builder --mac --arm64 --dir --config.electronDist=node_modules/electron/dist --publish never && node scripts/packaging/distribute.mjs && node scripts/packaging/check.mjs",
    "package:win": "node scripts/packaging/prepare-windows.mjs && npm run build && cross-env ELECTRON_BUILDER_CACHE=.noobi-private/electron-builder-cache electron-builder --win zip --x64 --publish never --config.directories.output=release/windows && node scripts/packaging/check-windows.mjs"
  },
  "dependencies": {
    "@fontsource/press-start-2p": "^5.3.0",
    "@openai/codex": "0.148.0",
    "@vp-tw/cjk-web-fonts-fusion-pixel-font": "^0.0.1",
    "fflate": "0.8.3",
    "lucide-react": "^0.468.0",
    "parse5": "8.0.1",
    "pngjs": "^7.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.185.1",
    "three-stdlib": "^2.36.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "43.3.0",
    "electron-builder": "^26.0.12",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^3.0.5",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "ai.ai2d.studio",
    "productName": "造境",
    "asar": true,
    "asarUnpack": [
      "node_modules/@openai/codex-*/vendor/**/*"
    ],
    "files": [
      "dist/**/*",
      "!dist/**/*.map",
      "package.json",
      "node_modules/three/**/*",
      "node_modules/three-stdlib/**/*",
      "node_modules/@openai/codex/**/*",
      "node_modules/@openai/codex-*/**/*",
      "build/NOTICE.md"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": ".noobi-private/package-cache/studio.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "identity": "-",
      "hardenedRuntime": false,
      "notarize": false
    },
    "artifactName": "AI2D-Game-Studio-${version}-${arch}.${ext}",
    "npmRebuild": false,
    "win": {
      "icon": ".noobi-private/package-cache/studio.ico",
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Zaojing-${version}-win-${arch}.zip",
      "signExecutable": false,
      "requestedExecutionLevel": "asInvoker",
      "extraFiles": [
        {
          "from": "build/windows-使用说明.txt",
          "to": "先看这里.txt"
        }
      ],
      "files": [
        "dist/**/*",
        "!dist/**/*.map",
        "package.json",
        "node_modules/three/**/*",
        "node_modules/three-stdlib/**/*",
        "node_modules/@openai/codex/**/*",
        "node_modules/@openai/codex-*/**/*",
        "build/NOTICE.md",
        "!node_modules/@openai/codex-darwin-*/**/*",
        "!node_modules/@openai/codex-linux-*/**/*",
        "!node_modules/@openai/codex-win32-arm64/**/*"
      ]
    }
  }
}
